# Somente desenvolvimento local. Nao reutilizar estas credenciais em producao.
MYSQL_DATABASE=iseday_quiz
MYSQL_USER=iseday
MYSQL_PASSWORD=iseday_local
MYSQL_ROOT_PASSWORD=iseday_root_local
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://iseday:iseday_local@localhost:3306/iseday_quiz?charset=utf8mb4
APP_ENV=development
# Exemplo para desenvolvimento com dados ficticios. Substitua pelo aviso institucional aprovado.
PRIVACY_NOTICE_VERSION=development-v1
PRIVACY_NOTICE_TEXT=Ambiente de desenvolvimento. Use apenas dados ficticios para testar o quiz.
PARTICIPANT_SESSION_MINUTES=60
PARTICIPANT_REGISTRATION_LIMIT=60
PARTICIPANT_SUBMISSION_LIMIT=120
ADMIN_SESSION_MINUTES=480
ADMIN_LOGIN_LIMIT=10
