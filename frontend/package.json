{
  "name": "iseday-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build:assets": "vite build",
    "build": "npm run typecheck && npm run build:assets",
    "lint": "oxlint",
    "preview": "vite preview",
    "browser:install": "playwright install chromium",
    "browser:check": "node scripts/check-browser.mjs",
    "pretest": "npm run browser:check",
    "test": "playwright test",
    "pretest:preview": "npm run browser:check",
    "test:preview": "ISEDAY_UI_BUILD=1 playwright test",
    "test:build": "npm run build && npm run test:preview --",
    "pretest:live": "npm run browser:check",
    "test:live": "ISEDAY_UI_LIVE=1 playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
