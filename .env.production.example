# Copie para .env.production (ignorado pelo Git) e preencha antes de iniciar.
# Use somente o nome do domínio, sem http://, https://, caminho ou porta.
# Em um ensaio local, use localhost (certificado emitido pela CA local do Caddy).
SITE_ADDRESS=
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
APP_IMAGE_TAG=latest

POSTGRES_DB=iseday_quiz
POSTGRES_USER=iseday
# Gere com: openssl rand -hex 32. Repita a mesma senha na DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=
# Formato: postgresql+psycopg://iseday:SENHA@db:5432/iseday_quiz
# Caracteres reservados na senha precisam de codificação de URL; hex evita isso.

# Texto e versão aprovados pela instituição. Não reutilize o aviso de desenvolvimento.
PRIVACY_NOTICE_VERSION=
PRIVACY_NOTICE_TEXT=
PARTICIPANT_SESSION_MINUTES=60
PARTICIPANT_REGISTRATION_LIMIT=60
PARTICIPANT_SUBMISSION_LIMIT=120
ADMIN_SESSION_MINUTES=480
ADMIN_LOGIN_LIMIT=10
